# ae_maintainer.cfg 예시
#   OC 컴퓨터에서 프로그램과 같은 폴더에 'ae_maintainer.cfg' 로 복사한 뒤 값을 고치세요.
#   (이 파일 자체는 예시이며, 프로그램은 'ae_maintainer.cfg' 라는 이름만 읽습니다)
#   주석(#)과 빈 줄은 무시됩니다. 코드는 실행되지 않습니다(단순 key=value).

# 실행 모드: drive = OC가 직접 요청 / monitor = 읽기·표시만
mode=drive

# 요청 주기(초)
interval=60

# true = 관리 대상 슬롯의 유지기 자체 자동요청을 끄고 OC 단독으로 요청 (중복 방지)
# false = 유지기 자체 기능과 병행 (중복 요청 가능)
takeover=true

# 요청량 규칙
#   need  = min(배치, 부족분)      ※ 부족분을 넘지 않게 (권장)
#   batch = 배치 값 고정
#   fill  = 부족분을 배치 단위로 올림
batchMode=need

# true = 요청하지 않고 계산 결과만 표시
dryRun=false

# 아이템 이름(name) 매칭 실패 시 표시이름(label)으로 재검색
labelFallback=true

# 종료(Ctrl+C) 시 유지기 슬롯 enable 상태를 원래대로 복구
autoRestore=true

# ---- v1.2 추가 --------------------------------------------------------------

# AE CPU 가 같은 품목을 이미 제작 중이면 새 요청을 넣지 않음 (finalOutput 비교)
skipIfCrafting=true

# 유지기 자체가 그 슬롯을 작업 중(isDone=false)이면 건너뜀
skipIfMaintainer=true

# 위 판단에 activeItems/storedItems/pendingItems 까지 포함 (오탐 가능, 기본 꺼짐)
scanActiveItems=false

# 요청 후 이 초(기본 60) 안에 완료되지 않으면 요청을 중단하고 CPU 취소 시도 (0=끔)
requestTimeout=60

# 타임아웃 시 그 품목을 제작 중인 AE CPU 작업을 취소
cancelOnTimeout=true

# 중단 후 그 슬롯을 다시 요청하지 않을 시간(초). 0=즉시 재시도 가능
timeoutCooldown=0

# 화면에 다음 주기까지 남은 시간을 1초마다 표시
countdown=true

# 유지기가 여러 대일 때 특정 어댑터 주소 지정 (비워두면 첫 번째 사용)
# maintainerAddress=aaaa-1111-bbbb-2222

# ME Controller 가 여러 대일 때 특정 어댑터 주소 지정
# controllerAddress=cccc-3333-dddd-4444
